APP_NAME="Clinical Trial Watcher"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000
FRONTEND_URL="${APP_URL}"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
# Local Docker Compose values (see docker-compose.yml); change them outside local development.
DB_DATABASE=clinical_saas
DB_USERNAME=clinical_user
DB_PASSWORD=clinical_pass

# Host ports published by Docker Compose; change them if they are already in use.
APP_PORT=8000
FORWARD_DB_PORT=3306
VITE_PORT=5173

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=redis
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="alerts@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# JWT authentication (generate with: php artisan jwt:secret)
JWT_SECRET=
JWT_TTL=60

# ClinicalTrials.gov import
CLINICAL_TRIALS_BASE_URL=https://clinicaltrials.gov/api/v2
CLINICAL_TRIALS_PAGE_SIZE=100
CLINICAL_TRIALS_RETRY_TIMES=3
CLINICAL_TRIALS_RETRY_SLEEP_MS=1000

# Saved searches per account or team, the same on every plan
SAVED_SEARCH_LIMIT=100

# Stripe billing (Laravel Cashier). Pro AI and Team AI are monthly USD prices ($19 and $99);
# run `php artisan billing:check-prices` after setting the price IDs.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_AI=
STRIPE_PRICE_TEAM_AI=
CASHIER_CURRENCY=usd

# AI digests (any OpenAI-compatible API). Disabled: digests use the factual summary.
AI_DIGESTS_ENABLED=false
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT=30
AI_RETRIES=2
AI_MAX_INPUT_CHARS=12000
AI_MAX_OUTPUT_TOKENS=1200
AI_DIGEST_MAX_ITEMS=10
