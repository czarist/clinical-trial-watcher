   "trialDetails": {
    "clinicalTrialIdentifiers": {
     "fullTitle": "Dexamethasone for the treatment of traumatic brain injured patients with brain contusions and pericontusional edema: Study protocol for a prospective, randomized and double blind trial",
     "publicTitle": "Dexamethasone for the treatment of traumatic brain injured patients with brain contusions and pericontusional edema: Study protocol for a prospective, randomized and double blind trial",
     "secondaryIdentifyingNumbers": {
      "additionalRegistries": []
     }
    },
    "trialInformation": {
     "trialCategory": {
      "isLowIntervention": false,
      "trialPhase": "6",
      "trialCategory": "3",
      "justificationForTrialCategory": "Low interventional clinical trial",
      "trialCategoryId": 63547
     },
     "medicalCondition": {
      "partIMedicalConditions": [
       {
        "id": 72856,
        "medicalCondition": "Post-traumatic brain contusion with edema",
        "isConditionRareDisease": false
       }
      ]
     },
     "trialObjective": {
      "trialScopes": [
       {
        "code": "3",
        "trialScopeId": 209702
       },
       {
        "code": "5",
        "trialScopeId": 209703
       }
      ],
      "mainObjective": "Efficacy of dexamethasone in improving the prognosis of patients with TBI, brain contusions and pericontusional edema.",
      "secondaryObjectives": []
     },
     "eligibilityCriteria": {
      "principalInclusionCriteria": [
       {
        "id": 460267,
        "number": 1,
        "principalInclusionCriteria": "- Patients who have suffered a head injury and who present  on computed tomography (CT) one or more bruises brain with pericontusion edema. Those patients will be included  with bruises in which it was initially chosen  medical, non-surgical treatment."
       },
       {
        "id": 460268,
        "number": 2,
        "principalInclusionCriteria": "- Age equal to or greater than 18 years and less than 85 years"
       },
       {
        "id": 460269,
        "number": 3,
        "principalInclusionCriteria": "-Signature of the informed consent by the patient or his legal representative in case the patient cannot do so."
       }
      ],
      "principalExclusionCriteria": [
       {
        "id": 792268,
        "number": 1,
        "principalExclusionCriteria": "- Patients with TBI and contusions who have required surgery  Evacuation of brain contusion before randomization."
       },
       {
        "id": 792277,
        "number": 10,
        "principalExclusionCriteria": "- Patients with allergy or intolerance to the following excipients contents in dexamethasone/placebo capsules: lactose, starch  corn or microcrystalline cellulose."
       },
       {
        "id": 792278,
        "number": 11,
        "principalExclusionCriteria": "- Patients with a history of psychotic disorders."
       },
       {
        "id": 792279,
        "number": 12,
        "principalExclusionCriteria": "- Patients unable to take oral medication due to  swallowing problems and in which placing a  nasogastric tube."
       },
       {
        "id": 792280,
        "number": 13,
        "principalExclusionCriteria": "- Patient with any systemic condition that, at the discretion of the  investigator contraindicates the patient's inclusion in the study."
       },
       {
        "id": 792281,
        "number": 14,
        "principalExclusionCriteria": "Pregnant or breastfeeding patients."
       },
       {
        "id": 792269,
        "number": 2,
        "principalExclusionCriteria": "- Patients with TBI who have required a craniotomy before  randomization for any other reason: hematoma evacuation  subdural, epidural or sinking fracture."
       },
       {
        "id": 792270,
        "number": 3,
        "principalExclusionCriteria": "- Patients in a 3-point GCS situation with bilateral mydriasis"
       },
       {
        "id": 792271,
        "number": 4,
        "principalExclusionCriteria": "- Patients with an extracranial Injury Severity Score greater than 18  points."
       },
       {
        "id": 792272,
        "number": 5,
        "principalExclusionCriteria": "- Patients with associated spinal cord injuries."
       },
       {
        "id": 792273,
        "number": 6,
        "principalExclusionCriteria": "- Patients in whom the use of corticosteroids is contraindicated."
       },
       {
        "id": 792274,
        "number": 7,
        "principalExclusionCriteria": "- Patients who chronically take oral corticosteroids."
       },
       {
        "id": 792275,
        "number": 8,
        "principalExclusionCriteria": "- Patients included in another clinical trial."
       },
       {
        "id": 792276,
        "number": 9,
        "principalExclusionCriteria": "- Known intolerance or hypersensitivity to dexamethasone."
       }
      ]
     },
     "endPoint": {
      "primaryEndPoints": [
       {
        "id": 534855,
        "number": 1,
        "endPoint": "To evaluate the efficacy of treatment with dexamethasone compared to placebo,  measured by the proportion of patients who, one month after the trauma, present  good evolution according to the “Extended Glasgow Outcome Scale (GOSE)”.",
        "isPrimary": true
       }
      ],
      "secondaryEndPoints": []
