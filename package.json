{
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "typecheck": "npm run typecheck:ts && npm run typecheck:vue",
        "test": "vitest run",
        "typecheck:ts": "node node_modules/typescript/bin/tsc --noEmit -p tsconfig.ts.json",
        "typecheck:vue": "node scripts/vue-tsc.cjs --noEmit"
    },
    "devDependencies": {
        "@types/node": "^26.6.6",
        "@typescript/typescript6": "^6.0.2",
        "@vitejs/plugin-vue": "^6.0.11",
        "@vue/devtools-api": "^8.2.1",
        "@vue/test-utils": "^2.6.0",
        "jsdom": "^31.0.1",
        "laravel-vite-plugin": "^3.2.1",
        "pinia": "^4.1.0",
        "typescript": "^7.0.2",
        "vite": "^8.3.8",
        "vitest": "^5.1.1",
        "vue": "^3.5.46",
        "vue-router": "^5.5.1",
        "vue-tsc": "^3.3.14"
    },
    "overrides": {
        "glob": "^14.0.6",
        "minimatch": "^11.0.9"
    }
}
