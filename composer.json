{
    "name": "clinical-trial-watcher/clinical-trial-watcher",
    "type": "project",
    "description": "Imports clinical studies from ClinicalTrials.gov, serves them through a JWT-authenticated API with search, alerts and Stripe billing, and a Vue web app.",
    "keywords": [
        "clinical-trials",
        "clinicaltrials.gov",
        "laravel",
        "api"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "guzzlehttp/guzzle": "^8.6",
        "laravel/cashier": "^16.11",
        "laravel/framework": "^13.43",
        "laravel/tinker": "^3.2",
        "tymon/jwt-auth": "^2.3"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "laravel/breeze": "^2.4",
        "laravel/pint": "^1.32",
        "laravel/sail": "^1.71",
        "mockery/mockery": "^1.6.15",
        "nunomaduro/collision": "^8.9",
        "phpunit/phpunit": "^13.4",
        "spatie/laravel-ignition": "^2.13"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
